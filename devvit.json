{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "karmass-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall",
        "styles": {
          "backgroundColor": "#09090BFF",
          "backgroundColorDark": "#09090BFF"
        }
      },
      "game": {
        "entry": "game.html",
        "styles": {
          "backgroundColor": "#09090BFF",
          "backgroundColorDark": "#09090BFF"
        }
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_COMMENT"
      ]
    }
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Publish next Karmass edition",
        "description": "Creates the next Karmass daily post now",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "marketingAssets": {
    "icon": "assets/app-icon.png"
  }
}
